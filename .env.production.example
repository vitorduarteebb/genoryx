# GENORYX ALPHA — copie para .env.production na VPS.
# Nunca commite o arquivo real.

NODE_ENV=production
RELEASE_CHANNEL=alpha

# Banco interno (não publicar portas).
POSTGRES_USER=nexora
POSTGRES_PASSWORD=troque-esta-senha-longa
POSTGRES_DB=nexora
DATABASE_URL=postgresql://nexora:troque-esta-senha-longa@postgres:5432/nexora?schema=public
REDIS_URL=redis://redis:6379

# JWT — gere valores aleatórios longos. Não reutilize o de desenvolvimento.
JWT_ACCESS_SECRET=troque-jwt-access-alpha
JWT_REFRESH_SECRET=troque-jwt-refresh-alpha
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Origens públicas (HTTPS / WSS). Sem localhost.
WEB_URL=https://alpha.genoryx.com.br
ADMIN_URL=
API_URL=https://alpha.genoryx.com.br/api
GAME_SERVER_URL=wss://alpha.genoryx.com.br/colyseus
GAME_SERVER_ALLOWED_ORIGINS=https://alpha.genoryx.com.br,https://srv1568762.hstgr.cloud:8443

# Público no bundle Next — só URLs, nunca secrets.
NEXT_PUBLIC_API_URL=https://alpha.genoryx.com.br/api
NEXT_PUBLIC_GAME_SERVER_URL=wss://alpha.genoryx.com.br/colyseus
NEXT_PUBLIC_RELEASE_CHANNEL=alpha
NEXT_PUBLIC_BUILD_ID=m2-alpha

API_PORT=3001
GAME_SERVER_PORT=2567

# Arte oficial — só no container da API. Nunca no Next.
CREATURE_IMAGE_PROVIDER=openai
OPENAI_CREATURE_IMAGE_MODEL=gpt-image-2-2026-04-21
CARD_ART_PROVIDER=openai
OPENAI_CARD_ART_MODEL=gpt-image-2-2026-04-21
GENETIC_CARD_ART_POLICY=FULL_CREATURE
GENETIC_CARD_ART_CREATURE_IDS=
CREATURE_VISUAL_GENERATION_CONCURRENCY=2
CREATURE_IMAGE_STORAGE_DIR=/app/var/creature-visuals
CARD_ART_STORAGE_DIR=/app/var/card-art
# OPENAI_API_KEY=  # NOVA chave só neste arquivo na VPS. Nunca git, frontend, logs ou chat.
# MESHY_API_KEY=
# MESHY_AI_MODEL=latest
CREATURE_MODEL_STORAGE_DIR=/app/var/creature-models
GENETIC_POWER_V1=false
EGG_AI_ART=true
INCUBATION_PROFILE=alpha
EGG_IMAGE_STORAGE_DIR=/app/var/egg-visuals
# Alpha: Lab V2 liga estas flags. Casual continua Battle.rulesVersion=V1.
COMBAT_DRAFT_V2=true
FORMATION_LINEAR_V2=true
FUSION_V2=true
CONVERGENCE_V1=true

# Só no host. POST /internal/chassis-reseed troca plantel legado por 5 fenótipos únicos.
# O script de deploy gera o valor se faltar. Vazio = endpoint recusa.
CHASSIS_RESEED_TOKEN=
