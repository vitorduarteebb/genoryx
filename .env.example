# Desenvolvimento local. Copie para .env na raiz. Nunca commite secrets reais.
# Produção Alpha: use .env.production.example → .env.production (docs/DEPLOYMENT.md).

NODE_ENV=development
RELEASE_CHANNEL=dev

DATABASE_URL=postgresql://nexora:nexora@localhost:5432/nexora?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret-dev-only
JWT_REFRESH_SECRET=change-me-refresh-secret-dev-only
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

API_PORT=3001
GAME_SERVER_PORT=2567
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002
API_URL=http://localhost:3001
GAME_SERVER_URL=ws://localhost:2567
GAME_SERVER_ALLOWED_ORIGINS=http://localhost:3000

# Bundle Next — só URLs públicas. Nunca JWT, senha ou private key.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_GAME_SERVER_URL=ws://localhost:2567
NEXT_PUBLIC_RELEASE_CHANNEL=dev
NEXT_PUBLIC_BUILD_ID=local

# Arte oficial (só backend/worker). Nunca NEXT_PUBLIC_*.
# CI e testes: mock. Alpha: openai quando a chave existir.
CREATURE_IMAGE_PROVIDER=mock
OPENAI_CREATURE_IMAGE_MODEL=gpt-image-2
CARD_ART_PROVIDER=mock
OPENAI_CARD_ART_MODEL=gpt-image-2
GENETIC_CARD_ART_POLICY=FULL_CREATURE
GENETIC_CARD_ART_CREATURE_IDS=
CREATURE_VISUAL_GENERATION_CONCURRENCY=2
# OPENAI_API_KEY=
# CREATURE_IMAGE_STORAGE_DIR=var/creature-visuals
# CARD_ART_STORAGE_DIR=var/card-art
# MESHY_API_KEY=
# MESHY_AI_MODEL=latest
# CREATURE_MODEL_STORAGE_DIR=var/creature-models
# Genetic Power V1 — off no Alpha até a prova local.
GENETIC_POWER_V1=false
EGG_AI_ART=false
INCUBATION_PROFILE=alpha
# EGG_IMAGE_STORAGE_DIR=var/egg-visuals
# Combat Matrix V2 — off no Alpha até a prova local.
COMBAT_DRAFT_V2=false
FORMATION_LINEAR_V2=false
FUSION_V2=false
CONVERGENCE_V1=false
