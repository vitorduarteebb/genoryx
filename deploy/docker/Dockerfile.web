FROM node:22-alpine AS builder
WORKDIR /app

ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_GAME_SERVER_URL
ARG NEXT_PUBLIC_RELEASE_CHANNEL=alpha
ARG NEXT_PUBLIC_BUILD_ID=dev

ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_GAME_SERVER_URL=$NEXT_PUBLIC_GAME_SERVER_URL
ENV NEXT_PUBLIC_RELEASE_CHANNEL=$NEXT_PUBLIC_RELEASE_CHANNEL
ENV NEXT_PUBLIC_BUILD_ID=$NEXT_PUBLIC_BUILD_ID

COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/
COPY packages/types/package.json packages/types/
COPY packages/config/package.json packages/config/
COPY packages/ui/package.json packages/ui/
COPY packages/game-engine/package.json packages/game-engine/
RUN npm ci

COPY tsconfig.base.json ./
COPY apps/web apps/web
COPY packages/types packages/types
COPY packages/config packages/config
COPY packages/ui packages/ui
COPY packages/game-engine packages/game-engine
RUN npm run build -w @nexora/types -w @nexora/config -w @nexora/ui -w @nexora/game-engine -w @nexora/web

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
RUN addgroup -S nexora && adduser -S nexora -G nexora

COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/apps/web/public ./apps/web/public

USER nexora
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
